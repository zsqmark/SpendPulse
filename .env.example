GEMINI_API_KEY=
DEEPSEEK_API_KEY=
# Tencent Hunyuan (OpenAI-compatible endpoint, key from the Hunyuan console)
HUNYUAN_API_KEY=
# Optional: force one provider for everything ("deepseek" | "gemini" | "hunyuan").
# The scan dialog can override this per upload.
LLM_PROVIDER=
# Optional model overrides (defaults: hunyuan-vision-latest for vision, hunyuan-turbos-latest for text)
HUNYUAN_MODEL=
HUNYUAN_VISION_MODEL=
HUNYUAN_TEXT_MODEL=
PORT=3000
