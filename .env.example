# ---------------------------------------------------------------------------
# AI provider
# SpendPulse uses ONE provider for invoice OCR, the chat copilot and catalog
# matching. Switch providers without touching code.
# ---------------------------------------------------------------------------
# LLM_PROVIDER: "deepseek" (default) | "gemini"
LLM_PROVIDER="deepseek"

# --- DeepSeek (default; vision-capable "deepseek-flash" model) ---
DEEPSEEK_API_KEY=""
# Optional overrides:
# DEEPSEEK_BASE_URL="https://api.deepseek.com"
# DEEPSEEK_VISION_MODEL="deepseek-flash"   # OCR / image input
# DEEPSEEK_TEXT_MODEL="deepseek-flash"     # chat copilot + catalog matching
# DEEPSEEK_THINKING="off"                  # "on" = reasoning mode (slower, pricier)

# --- Gemini (alternative provider) ---
GEMINI_API_KEY=""
# GEMINI_OCR_MODEL="gemini-2.5-flash"
# GEMINI_CHAT_MODEL="gemini-2.5-flash"

# --- OCR chunking (long invoices are split so responses stay within output limits) ---
# OCR_PAGES_PER_REQUEST="6"

# --- Source document archive ---
# Uploaded invoice pages are stored under data/documents/<invoiceId>/ so the
# extracted values can be checked against the original scan. Cap per invoice.
# DOCUMENT_STORE_MAX_MB="120"

# APP_URL: The URL where this app is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="http://localhost:3000"
