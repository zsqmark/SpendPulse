GEMINI_API_KEY=
DEEPSEEK_API_KEY=
# Tencent TokenHub (Hunyuan family + DeepSeek/GLM/Kimi behind one OpenAI-compatible endpoint).
# Create the key in the TokenHub console -> API Key Management.
HUNYUAN_API_KEY=
# Optional: force one provider for everything ("deepseek" | "gemini" | "hunyuan").
# The scan dialog can override this per upload.
LLM_PROVIDER=
# Defaults: hy-vision-2.0-instruct for vision, hy4 for text.
# Accounts on the LEGACY Hunyuan platform instead set:
#   HUNYUAN_BASE_URL=https://api.hunyuan.cloud.tencent.com/v1
#   HUNYUAN_VISION_MODEL=hunyuan-vision-latest
#   HUNYUAN_TEXT_MODEL=hunyuan-turbos-latest
HUNYUAN_MODEL=
HUNYUAN_VISION_MODEL=
HUNYUAN_TEXT_MODEL=
PORT=3000
